{
  "name": "@factory/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Data contracts, frontmatter reading and status derivation for the agent factory. Pure functions over a project path.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "js-yaml": "^5.4.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9"
  }
}
