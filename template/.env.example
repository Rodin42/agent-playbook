# ============================================================================
# .env.example — copy to .env and fill in. NEVER commit .env.
# All secrets live here; config files must not contain credentials.
# This file is the FACTORY's env (tokens the orchestrator injects into sandboxes).
# The application you build keeps its own env file next to its code (e.g.
# apps/backend/.env, from its own .env.example) — never mix the two.
# ============================================================================

# Claude subscription token for the claude-code harness (Max plan).
# Generate ONCE on your own machine:  claude setup-token
# (opens browser auth, prints the token — it is not saved anywhere by the CLI).
# The orchestrator injects this ONLY into sandboxes; avoid exporting it in your
# local shell profile — it would override your normal `claude` login there.
CLAUDE_CODE_OAUTH_TOKEN=

# e2b sandbox runtime (Phase B) — from e2b.dev dashboard
E2B_API_KEY=

# GitHub push auth for sandboxes: fine-grained PAT, THIS repo only, permissions:
# contents read/write (push feature/* branches) + pull requests write. Never admin.
# The operator's own `gh` auth handles merge locally — this token never merges.
GITHUB_TOKEN=

# OPTIONAL — only when switching harness to pi with Anthropic API billing.
# Do NOT set together with CLAUDE_CODE_OAUTH_TOKEN in the same environment:
# Claude Code warns on auth conflicts and the API key bills separately.
# ANTHROPIC_API_KEY=

# OPTIONAL — other pi providers after the switch (examples)
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
